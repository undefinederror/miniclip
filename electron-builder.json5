{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.miniclip.app",
  "asar": true,
  "productName": "Miniclip",
  "executableName": "Miniclip",
  "directories": {
    "output": "release/${version}"
  },
  "files": [
    "dist",
    "dist-electron"
  ],
  "extraResources": [
    {
      "from": "build/metainfo/com.miniclip.app.metainfo.xml",
      "to": "../usr/share/metainfo/com.miniclip.app.metainfo.xml"
    }
  ],
  "linux": {
    "target": [
      "appimage",
      "deb",
      "snap"
    ],
    "category": "Utility",
    "executableName": "miniclip",
    "icon": "public/icon.png",
    "synopsis": "A simple clipboard manager for Linux with history tracking",
    "description": "Miniclip is a simple clipboard manager for Linux. Keep track of your clipboard history and quickly access previously copied items.\n\nFeatures:\n- Clipboard history tracking\n- Text and image support\n- System tray integration\n- Quick access via global shortcut",
    "desktop": {
      "Keywords": "clipboard;copy;paste;history;",
      "StartupWMClass": "com.miniclip.app"
    },
    "artifactName": "miniclip-${version}-x86_64.${ext}"
  },
  "publish": {
    "provider": "github",
    "vPrefixedTagName": false,
    "releaseType": "release"
  },
  "snap": {
    "confinement": "strict",
    "grade": "stable",
    "base": "core22",
    "plugs": [
      "home",
      "desktop",
      "desktop-legacy",
      "x11",
      "wayland",
      "browser-support",
      "system-observe",
      {
        "shmem": {
          "interface": "shared-memory",
          "private": true
        }
      }
    ],
    "environment": {
      "TMPDIR": "$XDG_RUNTIME_DIR",
      "DISABLE_WAYLAND": "1",
      "ELECTRON_DISABLE_SANDBOX": "1"
    },
    "publish": {
      "provider": "snapStore",
      "channels": [
        "stable"
      ]
    }
  }
}