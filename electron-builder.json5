{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.miniclip.app",
  "asar": true,
  "productName": "Miniclip",
  "executableName": "miniclip",
  "directories": {
    "output": "release/${version}"
  },
  "files": [
    "dist",
    "dist-electron"
  ],
  "extraResources": [
    {
      "from": "build/metainfo/com.miniclip.app.appdata.xml",
      "to": "../usr/share/metainfo/com.miniclip.app.appdata.xml"
    },
    {
      "from": "build/applications/com.miniclip.app.desktop",
      "to": "../usr/share/applications/com.miniclip.app.desktop"
    },
  ],
  "linux": {
    "target": [
      "appimage",
      "deb",
      "snap"
    ],
    "category": "Utility",
    "icon": "public/icon.png",
    "synopsis": "A simple clipboard manager for Linux with history tracking",
    "description": "Miniclip is a simple clipboard manager for Linux. Keep track of your clipboard history and quickly access previously copied items.",
    "syncDesktopName": true,
    "desktop": {
      "entry": {
        "Keywords": "clipboard;copy;paste;history;"
      }
    },
    "artifactName": "miniclip-${version}-x86_64.${ext}"
  },
  "publish": {
    "provider": "github",
    "vPrefixedTagName": false,
    "releaseType": "release"
  },
  beforePack:"./scripts/fix-appimage.mjs",
  "snapcraft": {
    "base": "core24",
    "core24": {
      "useLXD": true,
      // When running as a snap the app renames its app id to
      // "<snap instance>_<desktop file>.desktop" (see electron/main.ts) so that Linux
      // desktops can link its windows to the desktop file snapd installs as
      // miniclip_com.miniclip.app.desktop. X11 sessions match on WM_CLASS instead, so keep
      // StartupWMClass in sync with that renamed id. deb/AppImage keep the linux.desktop /
      // desktopName value, which already matches their app id.
      "desktop": {
        "entry": {
          "StartupWMClass": "miniclip_com.miniclip.app"
        }
      },
      "autoStart": true,
      "confinement": "strict",
      "grade": "stable",
      "summary": "A simple clipboard manager for Linux with history tracking",
      "description": "Miniclip is a simple clipboard manager for Linux. It monitors your clipboard and stores a history of entries (text and images) so you can quickly access previously copied items.\n\nKey features:\n- Clipboard history tracking\n- Text and image support\n- System tray integration\n- Quick access via global shortcut",
      "plugs": [
        "home",
        "desktop",
        "desktop-legacy",
        "x11",
        "wayland",
        "browser-support",
        "system-observe",
        {
          "shmem": {
            "interface": "shared-memory",
            "private": true
          }
        }
      ],
      "environment": {
        // NOTE: do not try to force the X11/XWayland backend from here. snapd strips
        // XDG_SESSION_TYPE from the app environment even when a snap declares it, so the
        // appendSwitch('ozone-platform', 'x11') call in electron/main.ts does it instead.
        "TMPDIR": "$XDG_RUNTIME_DIR"
      }
    },
    "publish": [
      {
        "provider": "snapStore",
        "channels": "stable"
      },
    ]
  }
}