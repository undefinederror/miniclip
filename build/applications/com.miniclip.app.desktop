[Desktop Entry]
Name=Miniclip
Exec=AppRun --no-sandbox %U
Terminal=false
Type=Application
Icon=miniclip
StartupWMClass=com.miniclip.app
X-AppImage-Version=1.3.2
Keywords=clipboard;copy;paste;history;
Comment=Miniclip is a simple clipboard manager for Linux. Keep track of your clipboard history and quickly access previously copied items.
Categories=Utility;
